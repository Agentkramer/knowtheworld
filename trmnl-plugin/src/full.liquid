{%- comment -%}
  Country of the day — full layout (TRMNL X 1872×1404, also fine on OG 800×480).
  Setup (lang, base, idx, country) comes from the shared markup. Map: a single
  inline SVG stacks the static world basemap and today's country overlay via the
  shared viewBox. Only data.json is polled; the map geometry is static assets.
{%- endcomment -%}
{%- if country -%}
<div class="layout">
  <div class="columns portrait:flex--col">

    <div class="column portrait:w--full">
      <svg class="image image-dither w--full" viewBox="0 0 1000 520" preserveAspectRatio="xMidYMid meet">
        <image href="{{ base }}/trmnl/basemap.svg" width="1000" height="520" />
        <image href="{{ base }}/trmnl/maps/{{ country.c3 }}.svg" width="1000" height="520" />
      </svg>
    </div>

    <div class="column portrait:w--full">
      <span class="label label--underline">{{ ui[lang].ofDay }}</span>
      <span class="value value--xlarge">{{ country.n[lang] }}</span>

      <div class="flex flex--col gap--medium w--full">
        <div class="item">
          <div class="content">
            <span class="value value--large">{{ country.cap[lang] }}</span>
            <span class="label">{{ ui[lang].capital }}</span>
          </div>
        </div>
        <div class="item">
          <div class="content">
            <span class="value value--large value--tnums">{{ country.pop }}</span>
            <span class="label">{{ ui[lang].population }}</span>
          </div>
        </div>
        <div class="item">
          <div class="content">
            <span class="value value--large value--tnums">{{ country.area }} km²</span>
            <span class="label">{{ ui[lang].area }}</span>
          </div>
        </div>
        <div class="item">
          <div class="content">
            <span class="value value--large">{{ regions[country.sr][lang] }}</span>
            <span class="label">{{ ui[lang].region }}</span>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>

<div class="title_bar">
  <img class="image" src="{{ base }}/favicon.svg" alt="" />
  <span class="title">Know the World</span>
  <span class="instance">{% if country.terr == 1 %}{{ ui[lang].territory }} · {% endif %}{{ ui[lang].asOf }}</span>
</div>
{%- else -%}
<div class="layout">
  <div class="columns">
    <div class="column flex flex--center">
      <span class="title title--large">Know the World</span>
      <span class="label">No data available</span>
    </div>
  </div>
</div>
{%- endif -%}
