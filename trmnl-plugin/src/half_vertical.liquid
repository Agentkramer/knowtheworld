{%- assign lang = lang | default: 'en' -%}
{%- assign base = asset_base | default: 'https://www.knowtheworld.net' -%}
{%- assign doy = 'now' | date: '%j' | minus: 1 -%}
{%- assign idx = doy | modulo: count -%}
{%- assign country = countries[idx] -%}

<div class="layout">
  <div class="column" style="justify-content: flex-start; gap: var(--gap);">
    <span class="label label--underline">{{ ui[lang].ofDay }}</span>
    <span class="text--mega" style="line-height: 1;">{{ country.n[lang] }}</span>

    <div style="position: relative; width: 100%; padding-top: 52%;">
      <img src="{{ base }}/trmnl/basemap.svg" alt=""
           style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain;" />
      <img src="{{ base }}/trmnl/maps/{{ country.c3 }}.svg" alt=""
           style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain;" />
    </div>

    <div class="item">
      <div class="content">
        <span class="value value--large">{{ country.cap[lang] }}</span>
        <span class="label">{{ ui[lang].capital }}</span>
      </div>
    </div>
  </div>
</div>

<div class="title_bar">
  <img class="image" src="{{ base }}/favicon.svg" alt="" />
  <span class="title">Know the World</span>
  <span class="instance">{{ ui[lang].asOfDate }}</span>
</div>
