{%- comment -%}
  GENERATED by scripts/build-trmnl.mjs — do not edit by hand.
  Shared setup prepended to every layout:
    - ui / regions: static localized strings (sourced from src/i18n.ts).
    - lang / base: form field + asset host (falls back to production).
    - country: today's entry, chosen by day-of-year with a modulo wrap.
  Guards a missing/empty payload: if countries is nil or empty, country is nil
  and each layout renders a fallback.
{%- endcomment -%}
{%- capture ui_json -%}{"en":{"capital":"Capital","population":"Population","area":"Area","region":"Region","founded":"Founded","ofDay":"Country of the day","territory":"Territory","asOfDate":"July 2026","asOf":"Data as of July 2026"},"de":{"capital":"Hauptstadt","population":"Einwohner","area":"Fläche","region":"Region","founded":"Gegründet","ofDay":"Land des Tages","territory":"Territorium","asOfDate":"Juli 2026","asOf":"Datenstand: Juli 2026"},"fr":{"capital":"Capitale","population":"Population","area":"Superficie","region":"Région","founded":"Fondation","ofDay":"Pays du jour","territory":"Territoire","asOfDate":"juillet 2026","asOf":"Données de juillet 2026"},"it":{"capital":"Capitale","population":"Popolazione","area":"Superficie","region":"Regione","founded":"Fondazione","ofDay":"Paese del giorno","territory":"Territorio","asOfDate":"luglio 2026","asOf":"Dati aggiornati a luglio 2026"},"es":{"capital":"Capital","population":"Población","area":"Superficie","region":"Región","founded":"Fundación","ofDay":"País del día","territory":"Territorio","asOfDate":"julio de 2026","asOf":"Datos de julio de 2026"}}{%- endcapture -%}
{%- assign ui = ui_json | parse_json -%}
{%- capture regions_json -%}{"Asia":{"en":"Asia","de":"Asien","fr":"Asie","it":"Asia","es":"Asia"},"Southern Asia":{"en":"Southern Asia","de":"Südasien","fr":"Asie du Sud","it":"Asia meridionale","es":"Asia meridional"},"Europe":{"en":"Europe","de":"Europa","fr":"Europe","it":"Europa","es":"Europa"},"Southeast Europe":{"en":"Southeast Europe","de":"Südosteuropa","fr":"Europe du Sud-Est","it":"Europa sudorientale","es":"Europa sudoriental"},"Africa":{"en":"Africa","de":"Afrika","fr":"Afrique","it":"Africa","es":"África"},"Northern Africa":{"en":"Northern Africa","de":"Nordafrika","fr":"Afrique du Nord","it":"Nordafrica","es":"África del Norte"},"Southern Europe":{"en":"Southern Europe","de":"Südeuropa","fr":"Europe du Sud","it":"Europa meridionale","es":"Europa meridional"},"Middle Africa":{"en":"Middle Africa","de":"Zentralafrika","fr":"Afrique centrale","it":"Africa centrale","es":"África central"},"Americas":{"en":"Americas","de":"Amerika","fr":"Amériques","it":"Americhe","es":"América"},"Caribbean":{"en":"Caribbean","de":"Karibik","fr":"Caraïbes","it":"Caraibi","es":"Caribe"},"South America":{"en":"South America","de":"Südamerika","fr":"Amérique du Sud","it":"Sudamerica","es":"América del Sur"},"Western Asia":{"en":"Western Asia","de":"Westasien","fr":"Asie de l'Ouest","it":"Asia occidentale","es":"Asia occidental"},"Oceania":{"en":"Oceania","de":"Ozeanien","fr":"Océanie","it":"Oceania","es":"Oceanía"},"Australia and New Zealand":{"en":"Australia and New Zealand","de":"Australien und Neuseeland","fr":"Australie et Nouvelle-Zélande","it":"Australia e Nuova Zelanda","es":"Australia y Nueva Zelanda"},"Central Europe":{"en":"Central Europe","de":"Mitteleuropa","fr":"Europe centrale","it":"Europa centrale","es":"Europa central"},"Eastern Europe":{"en":"Eastern Europe","de":"Osteuropa","fr":"Europe de l'Est","it":"Europa orientale","es":"Europa oriental"},"Western Europe":{"en":"Western Europe","de":"Westeuropa","fr":"Europe de l'Ouest","it":"Europa occidentale","es":"Europa occidental"},"Central America":{"en":"Central America","de":"Mittelamerika","fr":"Amérique centrale","it":"America centrale","es":"América Central"},"Western Africa":{"en":"Western Africa","de":"Westafrika","fr":"Afrique de l'Ouest","it":"Africa occidentale","es":"África occidental"},"Southern Africa":{"en":"Southern Africa","de":"Südliches Afrika","fr":"Afrique australe","it":"Africa australe","es":"África austral"},"South-Eastern Asia":{"en":"South-Eastern Asia","de":"Südostasien","fr":"Asie du Sud-Est","it":"Sud-est asiatico","es":"Sudeste asiático"},"Eastern Africa":{"en":"Eastern Africa","de":"Ostafrika","fr":"Afrique de l'Est","it":"Africa orientale","es":"África oriental"},"North America":{"en":"North America","de":"Nordamerika","fr":"Amérique du Nord","it":"America del Nord","es":"América del Norte"},"Eastern Asia":{"en":"Eastern Asia","de":"Ostasien","fr":"Asie de l'Est","it":"Asia orientale","es":"Asia oriental"},"Northern Europe":{"en":"Northern Europe","de":"Nordeuropa","fr":"Europe du Nord","it":"Europa settentrionale","es":"Europa septentrional"},"Melanesia":{"en":"Melanesia","de":"Melanesien","fr":"Mélanésie","it":"Melanesia","es":"Melanesia"},"Central Asia":{"en":"Central Asia","de":"Zentralasien","fr":"Asie centrale","it":"Asia centrale","es":"Asia central"},"Micronesia":{"en":"Micronesia","de":"Mikronesien","fr":"Micronésie","it":"Micronesia","es":"Micronesia"},"Polynesia":{"en":"Polynesia","de":"Polynesien","fr":"Polynésie","it":"Polinesia","es":"Polinesia"}}{%- endcapture -%}
{%- assign regions = regions_json | parse_json -%}
{%- assign lang = lang | default: 'en' -%}
{%- assign base = asset_base | default: 'https://www.knowtheworld.net' -%}
{%- assign country_count = countries.size -%}
{%- assign idx = 0 -%}
{%- if countries and country_count > 0 -%}
  {%- comment -%}
    Day counter. With a start date set, day 0 is that date, so the sequence
    begins at its first entry on the day the plugin is configured. Without one
    we fall back to the day of the year, which still rotates daily.
  {%- endcomment -%}
  {%- assign day_number = 'now' | date: '%j' | minus: 1 -%}
  {%- if start_date and start_date != '' -%}
    {%- assign now_seconds = 'now' | date: '%s' | plus: 0 -%}
    {%- assign start_seconds = start_date | date: '%s' | plus: 0 -%}
    {%- assign elapsed = now_seconds | minus: start_seconds -%}
    {%- assign day_number = 0 -%}
    {%- if elapsed > 0 -%}
      {%- assign day_number = elapsed | divided_by: 86400 -%}
    {%- endif -%}
  {%- endif -%}
  {%- assign idx = day_number | modulo: country_count -%}
  {%- comment -%} Shuffled unless the reader asked for A–Z. {%- endcomment -%}
  {%- if sequence != 'alphabetical' and order -%}
    {%- assign idx = order[idx] -%}
  {%- endif -%}
{%- endif -%}
{%- assign country = countries[idx] -%}
